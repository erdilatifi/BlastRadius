{
 "uid": "tenant-slo",
 "title": "Tenant SLO",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(tenant:slo_errors:ratio_rate5m, tenant)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Availability (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - tenant:slo_errors:ratio_rate5m{slo=\"availability\",tenant=~\"$tenant\"}",
     "legendFormat": "{{tenant}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Requests under latency target (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - tenant:slo_errors:ratio_rate5m{slo=\"latency\",tenant=~\"$tenant\"}",
     "legendFormat": "{{tenant}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Error budget remaining (6h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - tenant:slo_errors:ratio_rate6h{tenant=~\"$tenant\"} / tenant:slo_budget:ratio{tenant=~\"$tenant\"}",
     "legendFormat": "{{tenant}} {{slo}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Burn rate (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "tenant:slo_errors:ratio_rate1h{tenant=~\"$tenant\"} / tenant:slo_budget:ratio{tenant=~\"$tenant\"}",
     "legendFormat": "{{tenant}} {{slo}}"
    }
   ]
  }
 ]
}
