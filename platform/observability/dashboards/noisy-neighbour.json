{
 "uid": "noisy-neighbour",
 "title": "Noisy neighbour",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "CPU used",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"tenant-.*\",container!=\"\"}[1m]))",
     "legendFormat": "{{namespace}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "CPU throttled",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"tenant-.*\"}[1m])) / sum by (namespace) (rate(container_cpu_cfs_periods_total{namespace=~\"tenant-.*\"}[1m]))",
     "legendFormat": "{{namespace}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Memory working set",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace) (container_memory_working_set_bytes{namespace=~\"tenant-.*\",container!=\"\"})",
     "legendFormat": "{{namespace}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "p95 latency at the ingress",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket{service=~\"tenant-.*\"}[1m])))",
     "legendFormat": "{{service}}"
    }
   ]
  }
 ]
}
